# Keep shell scripts, Makefiles, and container files LF on every platform.
# Without this, a Windows checkout with core.autocrlf=true can break the
# container entrypoint and Makefile.
* text=auto
*.sh text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ps1 text eol=lf
